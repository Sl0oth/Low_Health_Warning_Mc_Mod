{
  "schemaVersion": 1,
  "id": "lowhelthwarning",
  "version": "${version}",
  "name": "Low Health Warning",
  "description": "Shows a configurable warning when your health drops below the threshold.",
  "authors": [
    "Sl0oth"
  ],
  "license": "CC0-1.0",
  "icon": "assets/lowhelthwarning/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      {
        "value": "slooth.lowhealth.LowHealthWarning",
        "adapter": "kotlin"
      }
    ],
    "client": [
      "slooth.lowhealth.LowHealthWarningClient"
    ],
    "modmenu": [
      "slooth.lowhealth.LowHealthModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_target}",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  },
  "custom": {
    "modmenu:api": true
  }
}
